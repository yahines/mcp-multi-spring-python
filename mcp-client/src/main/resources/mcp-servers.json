{
  "mcpServers": {
    "filesystem": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "E:/auto_formation/Dev_JAVA/mcp-multi-spring-python"
      ],
      "env": {}
    },
    "Python_MCP_Server": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "E:/auto_formation/Dev_JAVA/mcp-multi-spring-python/python-mcp-server",
        "mcp",
        "run",
        "E:/auto_formation/Dev_JAVA/mcp-multi-spring-python/python-mcp-server/server.py"
      ],
      "env": {}
    }
  }
}
